# Cloudflare Workers statik varlıkları için güvenlik başlıkları (Vercel'deki next.config.ts başlıklarının karşılığı).
# Değerler lib/site/security-headers.ts ile aynı olmalıdır; tests/unit/cloudflare-headers-213.test.ts denetler.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.paytr.com/js/iframeResizer.min.js; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; frame-src 'self' https://www.paytr.com; form-action 'self' https://www.paytr.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
